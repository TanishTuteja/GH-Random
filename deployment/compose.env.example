# Pass this file to Docker Compose with --env-file after copying it outside the
# repository, for example to /etc/gh-random/compose.env. Use an immutable GHCR
# image digest, never a mutable tag.
GH_RANDOM_IMAGE=ghcr.io/tanishtuteja/gh-random@sha256:replace-with-release-digest

# Pin these to reviewed image versions or digests before the first deployment.
POSTGRES_IMAGE=postgres:17-alpine
CADDY_IMAGE=caddy:2.10-alpine

# These files stay outside the repository and are readable only by root.
GH_RANDOM_POSTGRES_ENV_FILE=/etc/gh-random/postgres.env
GH_RANDOM_APP_ENV_FILE=/etc/gh-random/app.env
GH_RANDOM_CRAWLER_ENV_FILE=/etc/gh-random/crawler.env
GH_RANDOM_CADDY_ENV_FILE=/etc/gh-random/caddy.env
GITHUB_APP_PRIVATE_KEY_HOST_PATH=/etc/gh-random/github-app-private-key.pem
