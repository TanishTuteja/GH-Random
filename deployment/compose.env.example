# Pass this file to Docker Compose with --env-file after copying it outside the
# repository, for example to /etc/gh-random/compose.env. Use an immutable GHCR
# image digest, never a mutable tag.
GH_RANDOM_IMAGE=ghcr.io/tanishtuteja/gh-random@sha256:replace-with-release-digest

# Reviewed multi-platform index pins; update deliberately, then rehearse in CI.
POSTGRES_IMAGE=postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24
CADDY_IMAGE=caddy:2.11-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f

# These files stay outside the repository and are readable only by root.
GH_RANDOM_POSTGRES_ENV_FILE=/etc/gh-random/postgres.env
GH_RANDOM_APP_ENV_FILE=/etc/gh-random/app.env
GH_RANDOM_CRAWLER_ENV_FILE=/etc/gh-random/crawler.env
GH_RANDOM_CADDY_ENV_FILE=/etc/gh-random/caddy.env
GITHUB_APP_PRIVATE_KEY_HOST_PATH=/etc/gh-random/github-app-private-key.pem

# Conservative ceilings for the 1 GB OCI E2 micro, not reservations or a sizing
# guarantee. See deployment/LOW_MEMORY.md and measure on the actual VM.
DATABASE_CPUS=1.0
DATABASE_MEMORY=256m
DATABASE_MAX_CONNECTIONS=32
DATABASE_SHARED_BUFFERS=64MB
DATABASE_WORK_MEM=2MB
DATABASE_MAINTENANCE_WORK_MEM=32MB
DATABASE_AUTOVACUUM_WORK_MEM=16MB
DATABASE_MAX_PARALLEL_WORKERS=0
WEB_CPUS=1.0
WEB_MEMORY=128m
WEB_WORKERS=1
CRAWLER_CPUS=1.0
CRAWLER_MEMORY=192m
MIGRATE_CPUS=1.0
MIGRATE_MEMORY=128m
CADDY_CPUS=0.5
CADDY_MEMORY=64m
