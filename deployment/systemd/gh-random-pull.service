[Unit]
Description=Pull an approved GH Random production release over outbound HTTPS
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service
OnFailure=gh-random-alert@%n.service

[Service]
Type=exec
User=root
Group=root
UMask=0077
Environment=DOCKER_HOST=unix:///run/docker.sock
Environment=DOCKER_CONFIG=/run/gh-random-pull/docker
Environment=GH_CONFIG_DIR=/run/gh-random-pull/github
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
RuntimeDirectory=gh-random-pull
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/gh-random-automation/deployment/pull.py poll --config /etc/gh-random/pull.json
# No automatic wall-clock kill during DDL. Deployment SQL/session deadlines and
# stop handling remain owned by deploy.py. Never restart/replay a claimed request.
TimeoutStartSec=infinity
TimeoutStopSec=120s
KillMode=control-group
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gh-random/deployments /var/backups/gh-random /opt/gh-random/releases /etc/gh-random
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gh-random-pull
