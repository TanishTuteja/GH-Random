{
  "repository": "TanishTuteja/GH-Random",
  "creator_id": 12345,
  "credential": {
    "type": "app",
    "app_id": 12345,
    "client_id": "Iv23-replace-with-deployment-app-client-id",
    "installation_id": 12345,
    "private_key_file": "/etc/gh-random/deployment-app.pem"
  },
  "state_dir": "/var/lib/gh-random/deployments",
  "release_dir": "/opt/gh-random/releases",
  "env_file": "/etc/gh-random/compose.env",
  "backup_dir": "/var/backups/gh-random/encrypted",
  "backup_config": "/etc/gh-random/backup.json",
  "alerts_config": "/etc/gh-random/alerts.json",
  "gh_binary": "/usr/bin/gh",
  "url": "https://example.com",
  "project_name": "gh-random",
  "allow_initial_bootstrap": false
}
