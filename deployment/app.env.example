# The hostname is the Compose service name, not localhost.
DATABASE_URL=postgresql+psycopg://gh_random:replace-with-a-unique-long-production-password@database:5432/gh_random
# JSON list of exact public hostnames, without scheme/port; match GH_RANDOM_DOMAIN.
APP_ALLOWED_HOSTS=["example.com"]
CATALOG_MEMBERSHIP_RETENTION_DAYS=3
CATALOG_GENERATION_RETENTION_DAYS=7
