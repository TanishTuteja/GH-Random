# PostgreSQL is required locally and in deployment. Docker Compose reads these
# values to create the local database and test database.
POSTGRES_DB=gh_random
POSTGRES_USER=gh_random
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://gh_random:replace-with-a-local-development-password@127.0.0.1:5432/gh_random
TEST_DATABASE_URL=postgresql+psycopg://gh_random:replace-with-a-local-development-password@127.0.0.1:5432/gh_random_test

# Required only when starting the optional local pgAdmin browser interface.
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=5050

# Keep search traffic intentionally conservative.
GITHUB_SEARCH_DELAY_SECONDS=5

# A bounded backoff used only after GitHub explicitly rate-limits a search request.
GITHUB_RATE_LIMIT_RETRY_SECONDS=60
GITHUB_RATE_LIMIT_MAX_RETRIES=2
GITHUB_TRANSPORT_RETRY_SECONDS=60
GITHUB_TRANSPORT_MAX_RETRIES=2

# Keep a repository in the rolling catalog for this many days after it was last
# rediscovered by a successful crawl.
CATALOG_MEMBERSHIP_RETENTION_DAYS=3

# Required only when running the crawler. Do not put the PEM file in this repository.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# Uncomment only when the App has multiple installations; otherwise the crawler resolves it.
# GITHUB_APP_INSTALLATION_ID=
